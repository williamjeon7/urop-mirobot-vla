# ─────────────────────────────────────────────────────────────
# 외부 저장소 (수정하지 않은 업스트림 클론, docs/VENDORED.md 참조)
# 자체 .git 을 가지고 있어 그대로 커밋하면 깨진 gitlink 가 된다.
# ─────────────────────────────────────────────────────────────
/cosmos-policy/
/RosForMirobot-master/

# ─────────────────────────────────────────────────────────────
# 논문 PDF (docs/PAPERS.md 참조)
# 히스토리에 바이너리가 쌓이지 않게 뺀다. 각 기기에서 arXiv 로 받는다.
# 논문에서 확인한 내용은 docs 에 쪽수와 함께 적어 공유한다.
# ─────────────────────────────────────────────────────────────
/papers/

# ─────────────────────────────────────────────────────────────
# 문서에서 내보낸 PDF (원본은 .md 다 — 필요할 때 다시 내보낸다)
# /papers/ 와 달리 이건 우리가 만든 것이라 항상 .md 에서 재생성된다
# ─────────────────────────────────────────────────────────────
docs/**/*.pdf

# ─────────────────────────────────────────────────────────────
# 모델 체크포인트 / 가중치
# ─────────────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin.index.json

# ─────────────────────────────────────────────────────────────
# 데이터셋 / 실행 산출물
# ─────────────────────────────────────────────────────────────
data/
# LIBERO 영상·PNG (tools/libero_*.py) — *.mp4 만으로는 PNG 가 빠진다
rollouts/
logs/
wandb/
outputs/
artifacts/
checkpoints/
*.h5
*.hdf5
*.mp4
!docs/W5/images/custom_task_validation/*.mp4
!docs/W5/images/extended_task_validation/*.mp4
!docs/W5/images/custom_bddl_monitoring.mp4
!docs/W5/images/custom_bddl_predicate_test.mp4
!docs/W5/images/panda_drawer_action.mp4
!docs/W6/images/mirobot/*.mp4
*.avi

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# 가상환경
#   이 프로젝트는 노트북 쪽 venv 이름을 urop 으로 통일한다. 서버의 conda 환경
#   이름과 같지만 서로 다른 물건이다 (README.md "가상환경부터 만든다" 참조).
urop/
.venv/
venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────
# 에디터 / OS
#   .vscode/settings.json 만 공유하고 나머지는 개인 설정이므로 제외
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# 로컬 전용 설정 (시리얼 포트, 브리지 IP 등 장비마다 다른 값)
# ─────────────────────────────────────────────────────────────
.env
.env.local
*.local.yaml
*.local.json
