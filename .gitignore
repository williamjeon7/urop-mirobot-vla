# ─────────────────────────────────────────────────────────────
# 외부 저장소 (수정하지 않은 업스트림 클론, docs/VENDORED.md 참조)
# 자체 .git 을 가지고 있어 그대로 커밋하면 깨진 gitlink 가 된다.
# ─────────────────────────────────────────────────────────────
/cosmos-policy/
/RosForMirobot-master/

# ─────────────────────────────────────────────────────────────
# 모델 체크포인트 / 가중치
# ─────────────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin.index.json

# ─────────────────────────────────────────────────────────────
# 데이터셋 / 실행 산출물
# ─────────────────────────────────────────────────────────────
data/
logs/
wandb/
outputs/
artifacts/
checkpoints/
*.h5
*.hdf5
*.mp4
*.avi

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# 가상환경 (pip install -e . 는 env 밖에서 관리)
.venv/
venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────
# 에디터 / OS
#   .vscode/settings.json 만 공유하고 나머지는 개인 설정이므로 제외
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# 로컬 전용 설정 (시리얼 포트, 브리지 IP 등 장비마다 다른 값)
# ─────────────────────────────────────────────────────────────
.env
.env.local
*.local.yaml
*.local.json
