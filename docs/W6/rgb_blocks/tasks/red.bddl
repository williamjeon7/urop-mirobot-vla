; Regions: Mirobot grip X240 Y-60 / X200 Y0 / X240 Y+60 mm (Zt measured spots, W5 CHECKLIST 9)
;   mapped at scale 0.663 (docs/W5/TABLE_ALIGNMENT.md 5). Half-width 0.030 m keeps a 40 mm cube within ~1.7 mm.
; Goal: the red block is lifted to z >= 1.0 m (LIBERO Up predicate).
(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick up the red block on the table)

  (:regions
    (red_region
      (:target main_table)
      (:ranges ((-0.1762 -0.1205 -0.1162 -0.0605)))
    )
    (green_region
      (:target main_table)
      (:ranges ((-0.2365 -0.0300 -0.1765 0.0300)))
    )
    (blue_region
      (:target main_table)
      (:ranges ((-0.1762 0.0605 -0.1162 0.1205)))
    )
  )

  (:fixtures main_table - table)
  (:objects
    red_block_1 - red_block
    green_block_1 - green_block
    blue_block_1 - blue_block
  )
  (:obj_of_interest red_block_1)
  (:init
    (On red_block_1 main_table_red_region)
    (On green_block_1 main_table_green_region)
    (On blue_block_1 main_table_blue_region)
  )
  (:goal
    (And
      (Up red_block_1)
    )
  )
)
