; Region: all three cubes share the Mirobot work area, grip X150-260 Y-100..+100 mm
;   (W5 CHECKLIST 4-3 D), mapped at scale 0.663 (docs/W5/TABLE_ALIGNMENT.md 5).
;   Cube centres span x -0.2819..-0.1160, y -0.1508..+0.1508 m; the range adds the
;   40 mm cube radius 0.0283 m that LIBERO subtracts. Colour order is random per seed.
(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Display the red green and blue cubes on the table)

  (:regions
    (work_region
      (:target main_table)
      (:ranges ((-0.3102 -0.1791 -0.0877 0.1791)))
    )
  )

  (:fixtures main_table - table)
  (:objects
    red_block_1 - red_block
    green_block_1 - green_block
    blue_block_1 - blue_block
  )
  (:obj_of_interest red_block_1 green_block_1 blue_block_1)
  (:init
    (On red_block_1 main_table_work_region)
    (On green_block_1 main_table_work_region)
    (On blue_block_1 main_table_work_region)
  )
  (:goal
    (And
      (On red_block_1 main_table_work_region)
      (On green_block_1 main_table_work_region)
      (On blue_block_1 main_table_work_region)
    )
  )
)
