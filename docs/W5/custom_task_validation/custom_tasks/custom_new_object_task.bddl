(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the custom marker box on the plate)
  (:regions
    (plate_region (:target main_table) (:ranges ((0.03 -0.04 0.07 0.0))))
    (custom_marker_box_region (:target main_table) (:ranges ((-0.09 0.17 -0.01 0.25))))
  )
  (:fixtures
    main_table - table
  )
  (:objects
    plate_1 - plate
    custom_marker_box_1 - custom_marker_box
  )
  (:obj_of_interest custom_marker_box_1 plate_1)
  (:init
    (On plate_1 main_table_plate_region)
    (On custom_marker_box_1 main_table_custom_marker_box_region)
  )
  (:goal (And (On custom_marker_box_1 plate_1)))
)