(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Push the plate to the front of the stove)
  (:regions
    (plate_region (:target main_table) (:ranges ((0.03 -0.04 0.07 0.0))))
    (stove_front_region (:target main_table) (:ranges ((-0.09 0.17 -0.01 0.25))))
    (stove_region (:target main_table) (:ranges ((-0.42 0.2 -0.4 0.22))))
  )
  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )
  (:objects
    plate_1 - plate
  )
  (:obj_of_interest plate_1 main_table_stove_front_region)
  (:init
    (On plate_1 main_table_plate_region)
    (On flat_stove_1 main_table_stove_region)
  )
  (:goal (And (On plate_1 main_table_stove_front_region)))
)